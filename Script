-- Speed Changer — Executor Version
-- Client-side WalkSpeed changer with a slider UI

local Players           = game:GetService("Players")
local UserInputService  = game:GetService("UserInputService")
local RunService        = game:GetService("RunService")

local LocalPlayer = Players.LocalPlayer
local PlayerGui   = LocalPlayer:WaitForChild("PlayerGui")

-- Character refs (re-acquired on respawn)
local Character, Humanoid
local function bind(char)
    Character = char
    Humanoid  = char:WaitForChild("Humanoid")
end
bind(LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait())
LocalPlayer.CharacterAdded:Connect(bind)

