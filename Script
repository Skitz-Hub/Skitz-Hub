Instance.new("UICorner", closeBtn).CornerRadius = UDim.new(0, 5)

-- ============================================================
-- LOGIC
-- ============================================================
local MIN_S, MAX_S = 16, 500
local currentSpeed = 16
local autoApply = true   -- keep re-applying every frame

local function setSpeed(v)
    currentSpeed = math.clamp(math.floor(v + 0.5), MIN_S, MAX_S)
    valueLabel.Text = "Speed: " .. currentSpeed
    local rel = (currentSpeed - MIN_S) / (MAX_S - MIN_S)
    barFill.Size = UDim2.new(rel, 0, 1, 0)
    if Humanoid then
        Humanoid.WalkSpeed = currentSpeed
    end
end

-- Slider drag
local dragging = false
local function updateFromX(x)
    local rel = math.clamp((x - barBg.AbsolutePosition.X) / barBg.AbsoluteSize.X, 0, 1)
    setSpeed(MIN_S + (MAX_S - MIN_S) * rel)
end

clickArea.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
       or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        updateFromX(input.Position.X)
    end
end)
UserInputService.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
       or input.UserInputType == Enum.UserInputType.Touch) then
        updateFromX(input.Position.X)
    end
end)
UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
       or input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
    end
end)

applyBtn.MouseButton1Click:Connect(function()
    if Humanoid then Humanoid.WalkSpeed = currentSpeed end
end)

resetBtn.MouseButton1Click:Connect(function()
    setSpeed(16)
end)

closeBtn.MouseButton1Click:Connect(function()
    sg:Destroy()
end)

-- Keep re-applying every frame while autoApply is on.
-- This re-writes WalkSpeed if the game (or a respawn) resets it.
-- If the server enforces speed server-side, this will not help —
-- the server will keep resetting you. That's expected.
RunService.Heartbeat:Connect(function()
    if autoApply and Humanoid and Humanoid.WalkSpeed ~= currentSpeed then
        Humanoid.WalkSpeed = currentSpeed
    end
end)

setSpeed(16)
print("[SpeedUI] Loaded — drag the bar, click Apply")
